set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name TOP_LEVEL_ENTITY top_level
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name SDC_FILE ../sdc/timing_constraints.sdc


# --- IP vJTAG (Platform Designer) ---
set_global_assignment -name QIP_FILE vjtag/synthesis/vjtag.qip

# --- Paquetes (deben compilarse antes que los modulos que los usan) ---
set_global_assignment -name SYSTEMVERILOG_FILE ../../sprint1/src/alu_types_pkg.sv

# --- ALU y display de 7 segmentos (sprint1) ---
set_global_assignment -name SYSTEMVERILOG_FILE ../../sprint1/src/alu_param.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../sprint1/src/decoder_4x16.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../sprint1/src/seven_segment_adapter.sv

# --- BCD y sincronizador de reset (sprint2) ---
set_global_assignment -name SYSTEMVERILOG_FILE ../../sprint2/src/binary_to_bcd_converter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../sprint2/src/key_sync.sv

# --- Fuentes del sprint3 ---
set_global_assignment -name NUM_PARALLEL_PROCESSORS 24
set_global_assignment -name SYSTEMVERILOG_FILE ../src/vjtag_interface.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../src/arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../src/fsm.sv
